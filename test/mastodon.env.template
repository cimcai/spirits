# Mastodon environment template for the interop test stack.
# The test_mastodon_interop.sh script copies this file to test/mastodon.env
# and substitutes FILL_IN placeholders with randomly generated secrets.
#
# DO NOT commit test/mastodon.env — it contains real secret values.

# ── Identity ─────────────────────────────────────────────────────────────────
LOCAL_DOMAIN=mastodon.test
WEB_DOMAIN=mastodon.test

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=postgres-mastodon
DB_PORT=5432
DB_NAME=mastodon
DB_USER=mastodon
DB_PASS=mastodon_password

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Secrets (filled in by test_mastodon_interop.sh) ──────────────────────────
SECRET_KEY_BASE=FILL_IN
OTP_SECRET=FILL_IN
VAPID_PRIVATE_KEY=FILL_IN
VAPID_PUBLIC_KEY=FILL_IN
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=FILL_IN
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=FILL_IN
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=FILL_IN

# ── TLS ──────────────────────────────────────────────────────────────────────
# Trust the local test CA so Mastodon can resolve HTTPS URLs on spirits.test
SSL_CERT_FILE=/etc/ssl/custom/ca.crt

# ── SMTP (disabled — not needed for interop test) ────────────────────────────
SMTP_SERVER=localhost
SMTP_PORT=25
SMTP_AUTH_METHOD=none
SMTP_OPENSSL_VERIFY_MODE=none
SMTP_ENABLE_STARTTLS=auto
SMTP_FROM_ADDRESS=notifications@mastodon.test

# ── Misc ─────────────────────────────────────────────────────────────────────
RAILS_ENV=production
RACK_ENV=production
NODE_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
SINGLE_USER_MODE=false

# Allow federation with local/private IP ranges (required for Docker network)
ALLOWED_PRIVATE_ADDRESSES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
